# ─────────────────────────────────────────────────────────────
#  m5rcel's tool doggy — environment configuration
#  Copy this file to `.env` and fill in the values.
#  NEVER commit your real .env file.
# ─────────────────────────────────────────────────────────────

# ── Discord (required) ───────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID ("Client ID") from the General Information page
DISCORD_CLIENT_ID=
# Optional: register commands instantly to a single guild while developing.
# Leave empty to register commands globally (can take up to 1 hour to appear).
DISCORD_GUILD_ID=

# Gateway identify browser property. Must be "Discord Android" or "Discord iOS".
DISCORD_IDENTIFY_BROWSER=Discord Android

# Register slash commands automatically when the bot starts. Leave this on and
# `docker compose up -d` is all you need; set it to false to only ever register
# with `npm run deploy`.
DISCORD_AUTO_DEPLOY=true

# Set to true only if "User Install" is enabled for your app in the Developer
# Portal (Installation -> Installation Contexts). When false the bot is a
# normal guild-installed bot that also works in DMs and group DMs.
DISCORD_USER_INSTALL=false

# ── Luau sandbox limits ──────────────────────────────────────
# Wall-clock execution limit for a single program, in milliseconds.
LUAU_TIMEOUT_MS=3000
# Address-space limit handed to the Luau process, in megabytes.
LUAU_MEMORY_MB=64
# Maximum number of output bytes captured from a program.
LUAU_MAX_OUTPUT=16000
# Maximum size of submitted source code, in bytes.
LUAU_MAX_SOURCE=20000
# Maximum number of programs executing at the same time (per worker).
LUAU_MAX_CONCURRENT=4
# How long a job may wait in the queue before it is rejected, in milliseconds.
LUAU_QUEUE_TIMEOUT_MS=10000

# ── Luau worker connection ───────────────────────────────────
# URL of the luau-worker service. Inside docker compose this is the service name.
LUAU_WORKER_URL=http://luau-worker:8080
# Shared secret between the bot and the worker. Generate one with:
#   openssl rand -hex 32
# The worker refuses every request that does not present this token.
LUAU_WORKER_TOKEN=change-me-to-a-long-random-string
# Port the worker listens on (inside its container).
LUAU_WORKER_PORT=8080

# ── Wikipedia ────────────────────────────────────────────────
WIKIPEDIA_DEFAULT_LANGUAGE=en
# Contact address advertised in the User-Agent, per the Wikimedia API etiquette.
WIKIPEDIA_CONTACT=https://github.com/m5rcel/m5rcels-tool-doggy
# Seconds to cache Wikipedia responses in memory.
WIKIPEDIA_CACHE_TTL_S=300

# ── Rate limits (per user) ───────────────────────────────────
# "<uses>/<window seconds>"
RATE_LIMIT_LUAU=3/20
RATE_LIMIT_QR_DECODE=5/30
RATE_LIMIT_WIKI=10/20
RATE_LIMIT_DEFAULT=20/10

# ── Logging ──────────────────────────────────────────────────
# trace | debug | info | warn | error | silent
LOG_LEVEL=info
# json | pretty
LOG_FORMAT=json
